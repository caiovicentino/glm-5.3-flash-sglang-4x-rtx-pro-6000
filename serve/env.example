# Copy to /root/.env on the box and `source` it before launching, or export in your shell.
export API_KEY="change-me"                  # bearer token clients must send
export SERVED_MODEL_NAME="glm-5.3-flash"    # what clients put in "model"
export MODEL_PATH="/root/model-glm53"       # LibertAIDAI/GLM-5.3-Flash-NVFP4 (182 GiB)
export ADAPTIVE_SPEC="/root/adaptive_spec.json"
